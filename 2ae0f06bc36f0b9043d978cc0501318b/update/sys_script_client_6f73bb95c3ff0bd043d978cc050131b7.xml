        <script><![CDATA[function onSubmit() {

    var start = g_form.getValue('shift_start');
    var end = g_form.getValue('shift_end');

    if (start && end && start >= end) {
        g_form.addErrorMessage('Shift Start must be earlier than Shift End.');
        return false;
    }

    if (parseInt(g_form.getValue('max_concurrent_incidents')) < 0) {
        g_form.addErrorMessage('Max Concurrent Incidents cannot be negative');
        return false;
    }
    g_form.clearMessages();
    return true;
}]]></script>
