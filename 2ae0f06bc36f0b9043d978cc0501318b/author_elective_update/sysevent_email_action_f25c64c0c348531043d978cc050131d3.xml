        <message_html><![CDATA[<p style="margin: 0 0 15px 0;">Hello,</p>
<p style="margin: 0 0 20px 0;">Please be advised that incident <strong>${number}</strong> has been reassigned.</p>
<!-- Data Summary Table -->
<p>${mail_script:display_reassignment_details}</p>
<table style="border-collapse: collapse; margin-bottom: 25px; font-size: 14px;" border="0" width="100%" cellspacing="0" cellpadding="8">
<tbody>
<tr style="background-color: #f8f9fa; border-bottom: 1px solid #e1e4e8;">
<td style="font-weight: 600; color: #555555;" width="35%">Incident Number:</td>
<td style="color: #0052cc; font-weight: 600;">${number}</td>
</tr>
<!-- SINGLE MAIL SCRIPT INJECTS BOTH ASSIGNEE ROWS HERE -->
<tr style="border-bottom: 1px solid #e1e4e8;">
<td style="font-weight: 600; color: #555555;">Priority:</td>
<td>${priority}</td>
</tr>
<tr style="background-color: #f8f9fa; border-bottom: 1px solid #e1e4e8;">
<td style="font-weight: 600; color: #555555;">Short Description:</td>
<td>${short_description}</td>
</tr>
</tbody>
</table>
<!-- Call to Action Button -->
<table style="margin-bottom: 25px;" border="0" cellspacing="0" cellpadding="0">
<tbody>
<tr>
<td style="border-radius: 4px;" align="center" bgcolor="#0052cc"><a style="font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; padding: 10px 20px; display: inline-block;" href="${mailto:sys_id}" target="_blank" rel="noopener">View Incident Details</a></td>
</tr>
</tbody>
</table>
<p style="margin: 0; font-size: 13px; color: #666666;">This notification is sent to both the previous and current assignee for tracking and handoff purposes.</p>]]></message_html>
